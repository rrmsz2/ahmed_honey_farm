# Copy to `.env` (never commit it). On the server: /opt/honey-farm/.env

ENVIRONMENT=production
DB_NAME=honey_farm

# Required: at least 32 random characters →  openssl rand -hex 32
JWT_SECRET=

# First admin account (created only when no admin exists). Min 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# WhatsApp via TextMeBot (can also be set later from the admin panel → Settings)
WHATSAPP_API_KEY=
# Receives new-order notifications; also shown as the shop contact number by default
ADMIN_PHONE=+9689XXXXXXX
# true = log messages instead of sending them (useful for local testing)
WHATSAPP_DRY_RUN=false

# Seed sample products/gallery on an empty database
SEED_SAMPLE_DATA=true

# Host port published on the Apps VM for the Caddy gateway (production only)
HOST_PORT=8095
